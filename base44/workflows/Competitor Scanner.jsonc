{
  "description": "Weekly automated scan of garage floor coating competitors and backlink opportunities for our parent companies, stored as CompetitorInsight records.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Competitor Scanner",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "competitor_scanner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanCompetitors",
            "args": {
              "mode": "full"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Scan competitors & backlinks",
            "description": "Weekly research run"
          }
        }
      }
    ]
  }
}