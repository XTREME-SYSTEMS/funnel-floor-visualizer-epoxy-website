  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "location": {
      "type": "string",
      "description": "User's location (ZIP code or city/state) collected during app onboarding"
    },
    "plan": {
      "type": "string",
      "description": "Active subscription plan ID ('home-designer' or 'contractor'). Set by the payments webhook on ORDER_APPROVED, cleared on SUBSCRIPTION_CANCELED/EXPIRED."
    }
  },
  "required": [
