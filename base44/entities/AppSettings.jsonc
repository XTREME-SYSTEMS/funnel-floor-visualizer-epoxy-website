{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "public_business_name": {
      "type": "string"
    },
    "legal_business_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "business_address": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "primary_city": {
      "type": "string"
    },
    "primary_state": {
      "type": "string"
    },
    "is_test_pricing": {
      "type": "boolean",
      "default": true
    },
    "size_defaults": {
      "type": "object",
      "properties": {
        "one_car": {
          "type": "number"
        },
        "two_car": {
          "type": "number"
        },
        "three_car": {
          "type": "number"
        },
        "four_car": {
          "type": "number"
        },
        "not_sure": {
          "type": "number"
        }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price_per_sqft": {
            "type": "number"
          }
        }
      }
    },
    "condition_adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "percent": {
            "type": "number"
          }
        }
      }
    },
    "minimum_project_price": {
      "type": "number",
      "default": 1800
    },
    "range_low_percent": {
      "type": "number",
      "default": 12
    },
    "range_high_percent": {
      "type": "number",
      "default": 15
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "multiplier": {
            "type": "number"
          }
        }
      }
    },
    "lead_scoring": {
      "type": "object",
      "properties": {
        "timeline": {
          "type": "object"
        },
        "garage_size": {
          "type": "object"
        },
        "has_full_address": {
          "type": "number"
        },
        "has_photos": {
          "type": "number"
        },
        "consultation_booked": {
          "type": "number"
        },
        "call_clicked": {
          "type": "number"
        }
      }
    },
    "salesperson": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "photo_url": {
          "type": "string"
        }
      }
    },
    "google_rating": {
      "type": "number"
    },
    "google_review_count": {
      "type": "number"
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before_url": {
            "type": "string"
          },
          "after_url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "calendar_url": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    },
    "consent_language": {
      "type": "string"
    },
    "hero_image_url": {
      "type": "string"
    },
    "seo": {
      "type": "object",
      "properties": {
        "site_name": {
          "type": "string"
        },
        "default_title": {
          "type": "string"
        },
        "default_description": {
          "type": "string"
        },
        "business_hours": {
          "type": "string"
        },
        "business_category": {
          "type": "string"
        },
        "gbp_url": {
          "type": "string"
        },
        "review_url": {
          "type": "string"
        },
        "social_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": []
}